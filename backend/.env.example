# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# Create a .env file in the /backend folder
# ==========================================

# 1. Database Connection URL
# For local dev: postgresql://admin:password@localhost:5432/keepalive?schema=public
# For Render: Get the "Internal Database URL" or "External Database URL" from your Render PostgreSQL dashboard.
DATABASE_URL="postgresql://admin:password@localhost:5432/keepalive?schema=public"

# 2. JWT Secret Key
# Generate a random string for this in production (e.g., using `openssl rand -hex 32`)
JWT_SECRET="your_super_secret_jwt_key_here"

# 3. SMTP Server settings (for sending Alert Emails)
# If using Gmail, use smtp.gmail.com, port 587, and an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# 4. Port (Optional, Render assigns this automatically)
PORT=5000
